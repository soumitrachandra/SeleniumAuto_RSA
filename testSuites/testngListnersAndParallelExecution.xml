<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel = "tests" name="Suite">		<!--commented this line as test run in parallel issue in sometime report giving the wrong test is failing-->
<!--<suite name="Suite">-->
<!-- Run test from mvn go to location where pom.xml is present and run command >>> mvn test -PRegression    -->
<!--  here "Regression"" is the name of the profile -->
<!-- Command to provide the browser type as an argument >>> mvn test -PRegression -Dbrowser=firefox  -->

<listeners>
	<listener class-name="rahulshettyacademy.TestComponents.Listeners"/>
</listeners>

  <test thread-count="5" name="Submit Order Test">
    <classes>
      <class name="rahulshettyacademy.tests.SubmitOrderTest"/>
    </classes>
  </test> <!-- Test -->
  
  <test thread-count="5" name="Error Validations Test">
    <classes>
      <class name="rahulshettyacademy.tests.ErrorValidationsTest"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->


